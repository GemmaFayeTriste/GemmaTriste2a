* { box-sizing: border-box; font-family: 'Segoe UI', sans-serif; }

body {
  background: #ffe4ec;
  background: linear-gradient(180deg, #ffd6e7, #fff0f5);
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding: 20px;
  margin: 0;
}

.card {
  background: white;
  width: 100%;
  max-width: 420px;
  padding: 28px;
  border-radius: 24px;
  box-shadow: 0 10px 30px rgba(255, 105, 180, 0.25);
  border: 2px solid #ffc2d4;
}

.hidden { display: none; }

.logo { font-size: 70px; text-align: center; }

h1 { text-align: center; color: #ff4d8d; margin: 5px 0; font-size: 32px; }
h2 { color: #ff4d8d; margin: 0 0 5px; }
h3 { color: #ff4d8d; margin-top: 25px; }
.subtitle { text-align: center; color: #888; margin-top: 0; }

input, textarea {
  width: 100%;
  padding: 14px;
  margin-top: 12px;
  border: 2px solid #ffc2d4;
  border-radius: 12px;
  outline: none;
  font-size: 15px;
  background: #fff5f8;
}

input:focus, textarea:focus { border-color: #ff4d8d; }

button {
  width: 100%;
  padding: 15px;
  margin-top: 16px;
  background: #ff4d8d;
  color: white;
  border: none;
  border-radius: 12px;
  font-size: 17px;
  font-weight: bold;
  cursor: pointer;
}
button:hover { background: #e63a7a; }
button.logout { background: white; color: #ff4d8d; border: 2px solid #ffc2d4; }

.mood-list {
  display: flex;
  justify-content: space-between;
  margin: 15px 0;
}

.mood-item {
  text-align: center;
  cursor: pointer;
  padding: 8px;
  border-radius: 50px;
  border: 2px solid transparent;
  flex: 1;
}
.mood-item.selected { background: #ffe0ec; border-color: #ff4d8d; }
.mood-item .emoji { font-size: 32px; display: block; }
.mood-item span { font-size: 11px; color: #555; }

.entry {
  background: #fff5f8;
  border: 1px solid #ffc2d4;
  border-radius: 14px;
  padding: 12px;
  margin-bottom: 10px;
  display: flex;
  gap: 10px;
}
.entry .emoji { font-size: 30px; }
.entry small { color: #999; }
